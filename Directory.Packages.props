<Project>
  <!--
    Central package management: every package version lives here. A project that needs a different version says so
    with VersionOverride and a comment explaining why.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Roslyn (analyzers target the Roslyn shipped with Unity 2021.3 / .NET 5 SDK)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <!-- Fixed version of a package that Workspaces 3.8 pulls into RID-specific restores (FlowTask.Analyzers.CodeFixes). -->
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
  </ItemGroup>
  <ItemGroup Label="Integrations">
    <!-- Keep the GodotSharp packages at the engine version, the same as Godot.NET.Sdk/x.y.z in tests/godot/GodotSmoke.csproj
         (that project disables the SDK's implicit references, so the versions no longer follow the SDK automatically). -->
    <PackageVersion Include="GodotSharp" Version="4.4.1" />
    <PackageVersion Include="GodotSharpEditor" Version="4.4.1" />
    <PackageVersion Include="Godot.SourceGenerators" Version="4.4.1" />
    <PackageVersion Include="R3" Version="1.3.1" />
    <PackageVersion Include="UniTask" Version="2.5.10" />
  </ItemGroup>
  <ItemGroup Label="Test frameworks">
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>
</Project>
