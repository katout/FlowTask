<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the optional bridge packages: FlowTask.UniTask and FlowTask.R3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Katout.FlowTask.Bridges.Tests</RootNamespace>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CS1998;NUnit2045</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowTask\FlowTask.csproj" />
    <ProjectReference Include="..\..\src\FlowTask.Testing\FlowTask.Testing.csproj" />
    <ProjectReference Include="..\..\src\FlowTask.UniTask\FlowTask.UniTask.csproj" />
    <ProjectReference Include="..\..\src\FlowTask.R3\FlowTask.R3.csproj" />
  </ItemGroup>
</Project>
