<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NativeAOT smoke test. Runs representative scenarios and steady-state zero-allocation checks without a
    test framework (a framework would pull in reflection). Publish and run:
      dotnet publish tests/FlowTask.AotSmoke -c Release -r win-x64
      artifacts/bin/FlowTask.AotSmoke/Release/net10.0/win-x64/publish/FlowTask.AotSmoke.exe
    It also runs under the JIT (dotnet run -c Release) for comparison.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Katout.FlowTask.AotSmoke</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Surface every trim/AOT warning individually instead of one summary line per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowTask\FlowTask.csproj" />
  </ItemGroup>
</Project>
