<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The same files compile in Unity (tools/unity/run-tests.ps1 copies them; C# 10 at most, docs/maintainers/engine-tests.md) and in
         tests/godot: pinned so that newer syntax fails here first. -->
    <LangVersion>10.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Katout.FlowTask.Tests</RootNamespace>
    <!-- Release-style codegen (struct state machines) so allocation tests measure the library, not the compiler. -->
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CS1998;NUnit2045</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowTask\FlowTask.csproj" />
    <ProjectReference Include="..\..\src\FlowTask.Testing\FlowTask.Testing.csproj" />
    <ProjectReference Include="..\..\src\FlowTask.Testing.NUnit\FlowTask.Testing.NUnit.csproj" />
  </ItemGroup>
</Project>
