<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test support: framework-agnostic helpers for driving a World without an engine. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>Katout.FlowTask.Testing</RootNamespace>
    <PackageId>FlowTask.Testing</PackageId>
    <Description>Engine-free testing for FlowTask: virtual time, run-until-complete, scope tree assertions.</Description>
    <PackageTags>$(PackageTags);testing</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowTask\FlowTask.csproj" />
  </ItemGroup>
  <!-- The FLOW rules check this project too: Unity users compile its sources next to the core's analyzer. -->
  <ItemGroup>
    <ProjectReference Include="..\FlowTask.Analyzers\FlowTask.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>
</Project>
