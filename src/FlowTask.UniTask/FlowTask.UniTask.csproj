<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UniTask <-> FlowTask bridge. A separate package so the core (FlowTask) stays dependency-free.
    Uses only the public Core API (FlowBridge.FromTask / TaskBridge / FlowHandle.AsTask).
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>Katout.FlowTask</RootNamespace>
    <AssemblyName>FlowTask.UniTask</AssemblyName>
    <PackageId>FlowTask.UniTask</PackageId>
    <Description>Bridges Cysharp UniTask and FlowTask in both directions (scope cancellation via CancellationToken, exceptions thrown at the await).</Description>
    <PackageTags>$(PackageTags);unitask</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UniTask" />
    <ProjectReference Include="..\FlowTask\FlowTask.csproj" />
  </ItemGroup>
  <!-- The FLOW rules check this project too: Unity users compile its sources next to the core's analyzer. -->
  <ItemGroup>
    <ProjectReference Include="..\FlowTask.Analyzers\FlowTask.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>
</Project>
